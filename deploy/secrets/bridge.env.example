# Bridge container only — IM credentials live here, never model credentials (design D5).
# Copy to bridge.env and chmod 600. Variable names follow Hermes (design D11).

CODEX_IM_PLATFORMS=telegram,email
# Default provider for new sessions: "openai" = ChatGPT login; or a custom provider id from agent.env.
CODEX_IM_DEFAULT_PROVIDER=openai
CODEX_IM_ALLOWED_PROVIDERS=openai
# Admins may use /provider and /release (empty = every allowlisted user), e.g. telegram:123456789,email:me@example.com
# CODEX_IM_ADMINS=
# Deadline for /stop and /new (interrupt included) and upper bound for any single Codex request, seconds:
# CODEX_IM_STOP_TIMEOUT=30
# CODEX_IM_RPC_TIMEOUT=60
# Projects and session bindings (optional), see deploy/config/codex-im.yaml.example
# CODEX_IM_CONFIG_FILE=/config/codex-im.yaml
# CODEX_IM_BUSY_POLICY=steer
# CODEX_IM_RATE_LIMIT_PER_MIN=10
# CODEX_IM_DEVELOPER_INSTRUCTIONS=

# ---- Telegram (use a bot that is NOT also used by a host-side Hermes) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_PROXY=http://proxy.example.com:912

# ---- Email (a dedicated mailbox) ----
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURITY=starttls
EMAIL_ALLOWED_USERS=
# authserv-id of the topmost Authentication-Results header your mail server adds, e.g. mx.google.com
EMAIL_AUTHSERV_ID=

# Corporate proxy for the IM APIs, if needed (the bridge -> agent relay is plain TCP and unaffected):
# HTTPS_PROXY=http://proxy.example.com:912
# NO_PROXY=agent,egress-proxy,localhost,127.0.0.1
