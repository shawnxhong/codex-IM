# Agent container only — model credentials live here, never IM credentials (design D5).
# Copy to agent.env and chmod 600. See docs/auth.md.

# ---- Mode 1: ChatGPT login (provider "openai") ----
# No key here. Log in once:  docker compose -f deploy/compose.yaml run --rm agent codex login --device-auth
# CODEX_IM_FORCED_LOGIN_METHOD=chatgpt

# ---- Mode 2: custom API key (endpoint must implement the Responses API, /v1/responses) ----
# CODEX_IM_PROVIDER_IDS=custom
# CODEX_IM_PROVIDER_CUSTOM_NAME=My Gateway
# CODEX_IM_PROVIDER_CUSTOM_BASE_URL=https://gateway.example.com/v1
# CODEX_IM_PROVIDER_CUSTOM_API_KEY=

# ---- Official OpenAI API key, configured as a custom provider (keeps auth.json free for ChatGPT login) ----
# CODEX_IM_PROVIDER_IDS=custom,openai-apikey
# CODEX_IM_PROVIDER_OPENAI_APIKEY_BASE_URL=https://api.openai.com/v1
# CODEX_IM_PROVIDER_OPENAI_APIKEY_ENV_KEY=OPENAI_API_KEY
# OPENAI_API_KEY=

# Corporate root CA for Codex (alternative to baking it into the image):
# CODEX_CA_CERTIFICATE=/home/agent/.codex/corp-ca.pem
